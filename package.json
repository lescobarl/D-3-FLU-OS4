{
  "name": "flu-os4",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "vitest run tests/hardcodeGuard.test.ts tests/protocolGuard.test.ts tests/stability-guards.test.ts tests/voiceSingleSourceGuard.test.ts tests/searchSingleRouteGuard.test.ts tests/voiceTurnSingleWriter.test.ts --reporter=dot --silent",
    "test": "vitest run --changed --reporter=dot --silent",
    "test:full": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:failed": "playwright test --last-failed --retries=1",
    "e2e:pizarron": "playwright test pizarron-funcionalidades.spec.ts",
    "e2e:auditoria": "playwright test auditoria-acciones-llm.spec.ts auditoria-despacho-real.spec.ts",
    "e2e:flu": "playwright test flu-settings-panel.spec.ts",
    "sync:ffmpeg": "node scripts/sync-ffmpeg-core.mjs",
    "postinstall": "node scripts/sync-ffmpeg-core.mjs",
    "gate": "node scripts/task-gate.mjs",
    "gate:baseline": "node scripts/task-gate-baseline.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "dexie": "^4.4.4",
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.2.108",
    "pdfkit": "^0.19.1",
    "pptx-parser": "^1.1.7-beta.9",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^6.30.6",
    "tesseract.js": "^7.0.0",
    "three": "^0.184.0",
    "uuid": "^14.0.1",
    "ws": "^8.21.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^3.1.0"
  },
  "overrides": {
    "stats-gl": {
      "three": "0.184.0"
    }
  }
}
