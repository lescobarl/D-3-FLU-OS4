{
  "id": "T-LINT-WARNINGS-RATCHET",
  "mode": "light",
  "objective": "Cerrar warnings de ESLint (unused-vars, eqeqeq y eslint-disable inútiles) sin cambiar comportamiento y fijar el ratchet --max-warnings=263.",
  "base": "HEAD",
  "ignore": [
    ".task/**",
    "scripts/task-gate*.mjs",
    "kilo.json",
    ".github/**",
    "scripts/auditoria.mjs",
    "plans/**",
    ".kilo/**",
    "eslint.config.mjs",
    "package.json"
  ],
  "allow": [
    "src/**"
  ],
  "maxFiles": 120,
  "maxLines": 2000,
  "dod": "npm run lint:eslint"
}
