# ============================================================
# FLU OS4 - Variables de Entorno
# ============================================================
# Copia este archivo como .env y configura tus claves API
# ============================================================

# Configuración de OpenRouter (RECOMENDADO — motor de texto por defecto)
# OpenRouter es una pasarela OpenAI-compatible. Modelo por defecto:
# Google Gemini 2.5 Flash Lite (barato, rápido y multimodal).
# Obtén tu API key en: https://openrouter.ai/settings/keys
VITE_OPENROUTER_API_KEY=tu_clave_api_de_openrouter_aqui
VITE_OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# URL base de OpenRouter (opcional — por defecto https://openrouter.ai/api/v1)
VITE_OPENROUTER_URL=https://openrouter.ai/api/v1

# API key de texto (opcional - respaldo legado)
# El motor de texto usa OpenRouter por defecto (VITE_OPENROUTER_API_KEY).
# Estas variables son SOLO respaldo si no se configura una clave de texto
# en Ajustes → Texto o en VITE_OPENROUTER_API_KEY.
VITE_GEMINI_API_KEY=tu_clave_api_de_gemini_aqui
VITE_GEMINI_MODEL=gemini-2.5-flash-lite
# URLs de la API de Gemini (opcionales — usan los valores por defecto oficiales)
VITE_GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
VITE_GEMINI_PREDICT_URL=https://generativelanguage.googleapis.com/v1beta/models/{model}:predict

# Configuración de DeepSeek (legacy - solo respaldo)
VITE_DEEPSEEK_API_KEY=tu_clave_api_de_deepseek_aqui
VITE_DEEPSEEK_MODEL=deepseek-chat
VITE_DEEPSEEK_VISION_MODEL=deepseek-vl
# URL base de DeepSeek (opcional — por defecto https://api.deepseek.com/v1)
VITE_DEEPSEEK_URL=https://api.deepseek.com/v1

# Proveedor de IA preferido (openrouter | gemini | local)
VITE_PREFERRED_AI_PROVIDER=openrouter

# Configuración de Pollinations.ai para generación de imágenes (SIEMPRE)
VITE_POLLINATIONS_MODEL=pollinations
VITE_POLLINATIONS_URL=https://image.pollinations.ai/prompt

# URL del servidor STT standalone de desarrollo (opcional — por defecto ws://127.0.0.1:8787)
VITE_STREAM_STT_DEV_URL=ws://127.0.0.1:8787

# URLs de sondeo del Health Monitor (opcional — separadas por coma; por defecto
# https://example.com y https://one.one.one.one)
VITE_NETWORK_PROBE_URLS=https://example.com,https://one.one.one.one

# Base de enlaces profundos de WhatsApp para Device Actions (opcional — por
# defecto https://wa.me)
VITE_WHATSAPP_WEB_BASE=https://wa.me

# ============================================================
# NOTAS:
# 1. La app usa SOLO 2 APIs:
#    - Texto    → OpenRouter → Google Gemini 2.5 Flash Lite (todo: minutas,
#                 chat, contrato, evaluación, visión y F1/F2/F3)
#    - Imágenes → Pollinations.ai (gratis, sin clave)
# 2. Todo es configurable desde Ajustes → "Texto" (modelo, clave y URL).
# 3. Alternativas: VITE_PREFERRED_AI_PROVIDER=gemini (también vía OpenRouter,
#    mismo formato OpenAI-compatible) o =local (Ollama / LM Studio en localhost).
# ============================================================