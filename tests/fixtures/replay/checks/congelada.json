{
  "name": "congelada",
  "descripcion": "El ASR entrego texto NUEVO durante 12 s y la caja no cambio: es una CONGELACION (hueco mayor que el tope), no una perdida ni una duplicacion.",
  "options": { "boxStallMs": 3500, "dupBlockWords": 4 },
  "observed": {
    "rows": [{ "text": "hola que tal", "speaker": "Hablante 1" }],
    "boxTrace": [
      { "t": 100, "text": "hola", "reason": "publish" },
      { "t": 12100, "text": "hola que tal", "reason": "publish" }
    ],
    "commits": [{ "t": 12100, "rowIndex": 0, "box": "hola que tal" }],
    "boxAtCommit": ["hola que tal"],
    "boxStall": { "maxGapMs": 12000, "from": "hola", "to": "hola que tal", "at": 100 }
  },
  "expected": {
    "schemaVersion": 1,
    "scenario": "congelada",
    "mode": "events",
    "approved": true,
    "expect": {
      "rowCount": 1,
      "rows": [{ "text": "hola que tal", "speaker": "Hablante 1" }],
      "box": ["hola que tal"]
    }
  },
  "want": { "status": "mismatch", "failing": ["boxStall"], "passing": ["boxLost", "boxDuplicated", "noBoxPrefixDuplication", "noBoxDuplicatedBlock"] }
}
