{
  "id": "C21",
  "mode": "full",
  "task": "Voz — un solo punto de síntesis (TTS)",
  "base": "__BASE__",
  "objective": "Un único módulo encapsula speechSynthesis; el resto consume esa API.",
  "allow": [
    "src/App.tsx",
    "src/hooks/useConfigPersistence.ts",
    "src/hooks/useFluParticipant.ts",
    "src/voice/hooks/useFluVoiceAssistant.js",
    "src/core/autonomy/healthMonitor.ts",
    "src/voice/lib/fluSpeech.js",
    "src/voice/components/FluParticipantSettingsPanel.jsx",
    "src/services/localTts.ts",
    "src/core/config/sharedConfig.ts",
    "tests/localTts.test.ts"
  ],
  "deny": [
    ".task/**",
    "scripts/task-gate.mjs",
    "scripts/audit-metric.mjs"
  ],
  "ignore": [
    ".task/**",
    "scripts/task-gate*.mjs",
    "scripts/audit-metric.mjs",
    "kilo.json",
    "plans/**"
  ],
  "maxFiles": 10,
  "maxLines": 500,
  "dod": "npx vitest run tests/ttsPuntoUnicoGuard.test.ts --reporter=dot && npm run typecheck",
  "guard": "npx vitest run tests/ttsPuntoUnicoGuard.test.ts --reporter=dot",
  "guardExpect": "green",
  "invariant": {
    "statement": "Un único módulo usa speechSynthesis",
    "metric": {
      "command": "node scripts/audit-metric.mjs tts-punto-unico",
      "target": 1
    },
    "base": "__BASE__",
    "guardFiles": [
      "tests/ttsPuntoUnicoGuard.test.ts"
    ]
  }
}
