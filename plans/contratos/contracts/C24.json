{
  "id": "C24",
  "mode": "full",
  "task": "Config — un solo default de modelo de texto",
  "base": "__BASE__",
  "objective": "El default del modelo de texto se define una vez (appConfig) y el resto lo importa; sin literales divergentes.",
  "allow": [
    "src/components/FluSettingsPanel.tsx",
    "src/core/config/voiceConfigCatalog.ts",
    "src/core/config/sharedConfig.ts",
    "src/core/config/appConfig.ts",
    "src/voice/lib/fluConfig.js",
    "src/voice/lib/gemini.js"
  ],
  "deny": [".task/**", "scripts/task-gate.mjs", "scripts/audit-metric.mjs"],
  "ignore": [".task/**", "scripts/task-gate*.mjs", "scripts/audit-metric.mjs", "kilo.json"],
  "maxFiles": 8,
  "maxLines": 400,
  "dod": "npx vitest run tests/modeloDefaultGuard.test.ts --reporter=dot && npm run typecheck",
  "guard": "npx vitest run tests/modeloDefaultGuard.test.ts --reporter=dot",
  "guardExpect": "green",
  "invariant": {
    "statement": "Un único módulo define el default del modelo de texto",
    "metric": { "command": "node scripts/audit-metric.mjs modelo-default", "target": 1 },
    "base": "__BASE__",
    "guardFiles": ["tests/modeloDefaultGuard.test.ts"]
  }
}
