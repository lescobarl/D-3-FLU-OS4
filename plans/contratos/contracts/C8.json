{
  "id": "C8",
  "mode": "full",
  "task": "Persistencia — un solo escritor de conversación",
  "base": "__BASE__",
  "objective": "Un único archivo escribe fluDb.conversations; App y la migración legacy dejan de escribir directo.",
  "allow": ["src/App.tsx", "src/hooks/useConversationPersistence.ts", "src/voice/lib/fluStorage.js"],
  "deny": [".task/**", "scripts/task-gate.mjs", "scripts/audit-metric.mjs"],
  "ignore": [".task/**", "scripts/task-gate*.mjs", "scripts/audit-metric.mjs", "kilo.json"],
  "maxFiles": 4,
  "maxLines": 350,
  "dod": "npx vitest run tests/conversacionEscritorUnicoGuard.test.ts --reporter=dot && npm run typecheck",
  "guard": "npx vitest run tests/conversacionEscritorUnicoGuard.test.ts --reporter=dot",
  "guardExpect": "green",
  "invariant": {
    "statement": "Un único archivo escribe fluDb.conversations",
    "metric": { "command": "node scripts/audit-metric.mjs conversacion-escritores", "target": 1 },
    "base": "__BASE__",
    "guardFiles": ["tests/conversacionEscritorUnicoGuard.test.ts"]
  }
}
