{
  "id": "C38",
  "mode": "full",
  "task": "Hardcode — umbrales de autonomía y voz desde config",
  "base": "__BASE__",
  "objective": "speakerDiarization, healthMonitor, decisionEngine, autoOptimization y participantProfiles toman sus umbrales de config.",
  "allow": [
    "src/voice/lib/speakerDiarization.js",
    "src/core/autonomy/healthMonitor.ts",
    "src/core/autonomy/decisionEngine.ts",
    "src/core/autonomy/autoOptimization.ts",
    "src/lib/participantProfiles.ts",
    "src/core/config/appConfig.ts",
    "src/core/config/sharedConfig.ts"
  ],
  "deny": [
    ".task/**",
    "scripts/task-gate.mjs",
    "scripts/audit-metric.mjs"
  ],
  "ignore": [
    ".task/**",
    "scripts/task-gate*.mjs",
    "scripts/audit-metric.mjs",
    "kilo.json",
    "plans/**"
  ],
  "maxFiles": 7,
  "maxLines": 400,
  "dod": "npx vitest run tests/umbralesConfigGuard.test.ts --reporter=dot && npm run typecheck",
  "guard": "npx vitest run tests/umbralesConfigGuard.test.ts --reporter=dot",
  "guardExpect": "green",
  "invariant": {
    "statement": "Ningún módulo define umbrales numéricos inline",
    "metric": {
      "command": "node scripts/audit-metric.mjs umbrales-autonomy",
      "target": 0
    },
    "base": "__BASE__",
    "guardFiles": [
      "tests/umbralesConfigGuard.test.ts"
    ]
  }
}
