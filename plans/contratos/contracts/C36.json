{
  "id": "C36",
  "mode": "full",
  "task": "Voz §9.2 — consumidores no re-normalizan",
  "base": "__BASE__",
  "objective": "generationTopic, agendaCommandParser y noteIntentParser dejan de normalizar; consumen la frase canónica.",
  "allow": [
    "src/lib/generationTopic.ts",
    "src/core/agenda/agendaCommandParser.ts",
    "src/voice/lib/noteIntentParser.js"
  ],
  "deny": [".task/**", "scripts/task-gate.mjs", "scripts/audit-metric.mjs"],
  "ignore": [".task/**", "scripts/task-gate*.mjs", "scripts/audit-metric.mjs", "kilo.json"],
  "maxFiles": 4,
  "maxLines": 300,
  "dod": "npx vitest run tests/consumidoresNormGuard.test.ts --reporter=dot && npm run typecheck",
  "guard": "npx vitest run tests/consumidoresNormGuard.test.ts --reporter=dot",
  "guardExpect": "green",
  "invariant": {
    "statement": "Ningún consumidor llama normalizadores de la frase canónica",
    "metric": { "command": "node scripts/audit-metric.mjs consumidores-normalizan", "target": 0 },
    "base": "__BASE__",
    "guardFiles": ["tests/consumidoresNormGuard.test.ts"]
  }
}
